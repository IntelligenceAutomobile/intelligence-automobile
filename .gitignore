# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
*.db
*.db-shm
*.db-wal

# scripts & fichiers de travail temporaires
*-tmp*.mjs
*-tmp*.ts
/screenshot-*.png
/Dif2.jpg
/Difference .jpg
/dif 3 .jpg

# outils / assets hors dépôt (gérés séparément)
/tools/
*.pt
/public/Audi TT 3/

# python (outils de génération de documents)
__pycache__/
*.pyc
