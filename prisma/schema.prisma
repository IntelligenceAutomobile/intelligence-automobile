generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String
  model        String
  year         Int
  mileage      Int
  price        Int
  color        String
  transmission String   @default("Automatique")
  fuel         String   @default("Diesel")
  power        Int?
  origin       String   @default("Allemagne")
  description  String   @default("")
  features     String   @default("[]")
  images       String   @default("[]")
  status       String   @default("disponible")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model CollabNote {
  id        String          @id @default(cuid())
  content   String
  status    String          @default("todo")
  tag       String          @default("général")
  urgency   String          @default("normale")
  author    String
  category  String          @default("général")
  imageUrl  String?
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  CollabComment[]
}

model CollabComment {
  id        String          @id @default(cuid())
  noteId    String
  parentId  String?
  content   String
  author    String
  createdAt DateTime        @default(now())
  note      CollabNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parent    CollabComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CollabComment[] @relation("CommentReplies")
}
