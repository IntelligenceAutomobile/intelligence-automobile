generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String
  model        String
  year         Int
  mileage      Int
  price        Int
  color        String
  transmission String   @default("Automatique")
  fuel         String   @default("Diesel")
  power        Int?
  origin       String   @default("Allemagne")
  // Régime de vente (mention légale affichée sur la fiche) :
  // stock | mandat-client | mandat-pro-eu — voir src/lib/sale-regime.ts
  saleRegime   String   @default("stock")
  description   String   @default("")
  descriptionEn String   @default("")
  features      String   @default("[]")
  featuresEn    String   @default("[]")
  images       String   @default("[]")
  conditionFacts        String   @default("[]")
  maintenanceHistory    String   @default("[]")
  maintenanceHighlights String   @default("[]")
  documents             String   @default("[]")
  status       String   @default("disponible")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("patron") // patron | gestionnaire | vendeur
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model CollabNote {
  id        String          @id @default(cuid())
  content   String
  status    String          @default("todo")
  tag       String          @default("général")
  urgency   String          @default("normale")
  author    String
  category  String          @default("général")
  imageUrl  String?
  images    String          @default("[]")
  attachments String        @default("[]")
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  CollabComment[]
}

model CollabComment {
  id        String          @id @default(cuid())
  noteId    String
  parentId  String?
  content   String
  attachments String        @default("[]")
  author    String
  createdAt DateTime        @default(now())
  note      CollabNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parent    CollabComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CollabComment[] @relation("CommentReplies")
}

// Liens utiles de l'atelier : veille concurrents, idées, inspiration, outils.
// L'aperçu (title, description, imageUrl…) est capturé au moment de l'ajout et
// figé en base : il reste stable même si le site visé change ou disparaît.
model CollabLink {
  id          String    @id @default(cuid())
  url         String
  note        String    @default("")
  tag         String    @default("") // "" | concurrent | idée | inspiration | outil
  title       String    @default("")
  description String    @default("")
  imageUrl    String?
  siteName    String    @default("")
  domain      String    @default("")
  author      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Quote {
  id     String @id @default(cuid())
  number String @unique

  kind   String @default("vehicule")  // vehicule | prestation
  status String @default("brouillon") // brouillon | envoye | accepte | refuse

  // Type de document et facturation
  docType       String  @default("devis")    // devis | facture | avoir
  factureKind   String  @default("complete") // complete | acompte | solde (si docType = facture)
  paymentStatus String  @default("impayee")  // impayee | payee (si docType = facture)
  paidDate      String  @default("")         // YYYY-MM-DD de paiement
  // Document d'origine : le devis d'une facture, la facture créditée d'un avoir.
  sourceQuoteId String?

  // Envoi, lecture et signature en ligne
  sentAt         String  @default("")  // horodatage ISO de l'envoi au client
  firstViewedAt  String  @default("")  // première ouverture du lien par le client
  viewCount      Int     @default(0)
  publicToken    String? @unique       // jeton du lien de consultation public
  signerName     String  @default("")
  signedAt       String  @default("")
  signedIp       String  @default("")

  // Relances (suivi commercial / paiement)
  relanceCount       Int    @default(0)
  lastRelanceDate    String @default("")      // YYYY-MM-DD de la dernière relance
  relanceSnoozeUntil String @default("")      // YYYY-MM-DD : masqué du centre de relances jusqu'à

  // Client (destinataire)
  clientName    String @default("")
  clientCompany String @default("")
  clientAddress String @default("")
  clientEmail   String @default("")
  clientPhone   String @default("")
  // Pays du client (code ISO à deux lettres) et numéro de TVA
  // intracommunautaire : ce qui décide si la vente sort sans TVA française.
  clientCountry   String @default("FR")
  clientVatNumber String @default("")
  // Langue du document remis au client : fr | en. Le back-office reste en français.
  docLang         String @default("fr")

  // Dates (chaînes calendaires YYYY-MM-DD, éditées telles quelles)
  issueDate    String
  validityDays Int    @default(30)

  // Lignes : JSON [{ designation, detail, qty, unitPrice, vehicleId? }]
  // unitPrice = HT en mode "tva20", TTC en modes "marge"/"exonere"
  items String @default("[]")

  // Fiscalité
  // intracom : livraison intracommunautaire exonérée, TVA autoliquidée par le client
  tvaMode String @default("marge") // marge | tva20 | exonere | intracom
  tvaRate Int    @default(20)

  // Acompte
  depositMode  String @default("percent") // percent | amount | none
  depositValue Float  @default(30)

  // Texte libre
  paymentTerms String @default("")
  notes        String @default("")

  // Personnalisation émetteur + logo (JSON) : { emitterName, emitterAddress, …, logoAlign, logoSize, logoVisible }
  branding String @default("{}")

  // Lien véhicule principal (optionnel)
  vehicleId String?

  // Identité du véhicule imprimée sur le document (JSON) :
  // { show, label, vin, plate, firstRegDate, mileageKm, energy, color, origin, photoUrl }
  // Recopiée depuis la fiche du stock et le dossier d'immatriculation, puis
  // figée : le devis doit continuer d'afficher ce qu'il affichait le jour de
  // son envoi, même si la voiture a roulé ou quitté le stock depuis.
  vehicleInfo String @default("{}")

  // Lien client CRM (optionnel)
  clientId String?

  // Opportunité que ce devis fait avancer. Sans ce lien, l'effet de bord
  // choisissait « la dernière opportunité ouverte touchée » : chez un client
  // qui a deux dossiers en cours, une recherche de voiture et la reprise de son
  // ancienne, le devis pouvait faire avancer le mauvais.
  leadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
}

// Journal du centre de relances : chaque action (email envoyé, relance notée au
// téléphone, report, arrêt, annulation) laisse une trace consultable à l'écran.
// Journal de la demande d'avis, bâti comme RelanceLog : chaque geste laisse une
// trace signée, et la question « est-ce que l'invitation est partie ? » se
// répond ici, y compris pour un client sorti de la liste.
//
// Table autonome, sans relation vers Client : le nom est figé à l'écriture, si
// bien que le journal survit à un effacement RGPD comme celui des relances
// survit à la suppression d'un devis.
model AvisLog {
  id         String @id @default(cuid())
  clientId   String
  clientName String @default("")
  action     String // invitation | rappel | manuel | avis | report | arret | reprise | ecart
  channel    String @default("") // email | main (rencontre au comptoir)
  step       Int    @default(0)  // 1 = invitation, 2 = rappel
  sentDay    String @default("") // jour de Paris de l'envoi
  detail     String @default("")
  author     String @default("")

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model RelanceLog {
  id      String @id @default(cuid())
  quoteId String
  number  String
  client  String @default("")
  action  String // email | telephone | report | arret | annulation
  detail  String @default("")
  author  String @default("")

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Liste rouge des destinataires : aucun message ne part vers ces adresses ni
// ces domaines, en production comme ailleurs. Complète la liste inscrite dans
// le code (src/lib/mailer.ts), qui elle ne peut pas être retirée.
model EmailBlock {
  id        String   @id @default(cuid())
  value     String   @unique // adresse complète, ou domaine (sous-domaines inclus)
  reason    String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
}

// Journal de tous les emails du site : envoyés, retenus avant l'envoi, refusés
// par le service. Écrit par la porte de sortie unique (src/lib/mailer.ts).
model EmailLog {
  id         String   @id @default(cuid())
  recipients String
  subject    String   @default("")
  outcome    String // envoye | retenu | refuse
  reason     String   @default("")
  origin     String   @default("") // relance | envoi-devis | contact | …
  messageId  String   @default("")
  mode       String   @default("") // live | atelier
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ── CRM : clients et opportunités de vente ──

model Client {
  id               String   @id @default(cuid())
  name             String
  company          String   @default("")
  email            String   @default("")
  phone            String   @default("")
  notes            String   @default("")
  // Suivi de la demande d'avis. `reviewRequestedAt` garde son sens d'origine :
  // le jour du DERNIER envoi. Le reste porte la mémoire du module, qui tenait
  // jusqu'ici dans cette seule chaîne : une invitation partie fermait le
  // dossier pour de bon, sans rappel possible ni geste de rattrapage.
  reviewRequestedAt String  @default("") // YYYY-MM-DD : dernière invitation envoyée
  reviewCount       Int     @default(0)  // nombre d'envois : invitation puis rappel
  reviewSnoozeUntil String  @default("") // YYYY-MM-DD : ligne mise de côté jusqu'à ce jour
  reviewOutcome     String  @default("") // "" | avis | ecarte | stop
  reviewOutcomeNote String  @default("") // motif court d'un écart

  // Mesure du geste : le lien du message passe par le site avant Google, ce qui
  // répond à la seule question qui compte, combien de clients l'ouvrent.
  // Le jeton sert aussi au QR code, au SMS et au lien d'opposition.
  reviewToken     String? @unique       // jeton du lien /avis/<jeton>
  reviewClickedAt String  @default("")  // YYYY-MM-DD : lien d'avis ouvert

  // Dernière activité commerciale réelle. `updatedAt` ne bougeait que si la
  // fiche elle-même était retouchée : le carnet, trié dessus, laissait tout en
  // bas un client dont on venait de noter un appel.
  lastActivityAt DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  leads            Lead[]

  // La déduplication à l'admission cherche par email puis par téléphone.
  @@index([email])
  @@index([lastActivityAt])
}

model Lead {
  id        String      @id @default(cuid())
  clientId  String
  stage     String      @default("nouveau") // nouveau | contacte | rdv | devis_envoye | gagne | perdu
  source    String      @default("manuel")  // site-contact | recherche-perso | aide-vente | manuel | telephone | autre

  // D'OÙ vient le visiteur, par opposition à `source` qui dit par QUEL
  // formulaire il est passé. Recopié du marqueur ?src= posé sur les liens semés
  // dans les annonces portails : c'est ce qui rendra calculable le coût par
  // contact, portail par portail.
  srcMarker String      @default("") // lacentrale | leboncoin | autoscout24 | facebook | carte…
  title     String      @default("")        // objet (ex: "Recherche SUV hybride")
  vehicleId String?                          // véhicule du stock concerné (optionnel)
  budget    Int?                             // budget indicatif en euros

  // Prochaine action : la seule chose qui empêche d'oublier un prospect. Rien
  // dans le module ne portait de date future, donc une affaire pouvait dormir
  // six mois sans que l'écran le dise.
  nextActionAt    String @default("") // jour YYYY-MM-DD, vide = rien de prévu
  nextActionLabel String @default("") // « Rappeler », « Relancer le devis »…

  // Issue : sans jour de clôture, aucun délai de vente n'est mesurable, et les
  // compteurs « gagné » comptaient depuis toujours faute de date sur quoi
  // borner un mois glissant. Le motif de perte, lui, est le seul moyen de
  // savoir plus tard si l'on perd sur le prix ou sur les délais.
  closedAt   String @default("") // jour YYYY-MM-DD, posé au passage en gagné/perdu
  lostReason String @default("") // prix | delai | vendu_ailleurs | reporte | financement | autre

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events    LeadEvent[]

  @@index([clientId])
  @@index([stage])
  @@index([nextActionAt])
}

// Suivi par véhicule : frais engagés (pour la marge) et journal d'enquête
// (problèmes constatés, solutions, administratif). Pas de suivi de réparation.
model VehicleCost {
  id          String   @id @default(cuid())
  vehicleId   String
  category    String   @default("autre") // achat | transport | preparation | controle | carrosserie | administratif | autre
  label       String   @default("")
  amountCents Int
  date        String                       // jour YYYY-MM-DD (saisi tel quel)
  createdAt   DateTime @default(now())

  @@index([vehicleId])
}

model VehicleNote {
  id        String   @id @default(cuid())
  vehicleId String
  type      String   @default("info") // probleme | solution | info | admin
  content   String
  resolved  Boolean  @default(false)   // pour les problèmes : réglé ou non
  author    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
}

// SAV & garanties : garanties vendues, suivi des échéances.
model Warranty {
  id           String   @id @default(cuid())
  clientName   String   @default("")
  clientEmail  String   @default("")
  vehicleLabel String   @default("")
  type         String   @default("constructeur") // constructeur | extension | garage
  startDate    String                              // YYYY-MM-DD
  endDate      String                              // YYYY-MM-DD (calculée à la création)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endDate])
}

// Marque blanche : thème visuel de l'instance (une seule ligne, id "default").
model BrandTheme {
  id         String   @id @default("default")
  name       String   @default("Intelligence Automobile")
  tagline    String   @default("Back-office")
  accent     String   @default("#6B9FEE")
  reviewLink String   @default("") // lien Google « laisser un avis »

  // Identité portée par les DOCUMENTS (devis, factures). Sans elle, un revendeur
  // obtenait un back-office à ses couleurs qui imprimait des devis au nom
  // d'Intelligence Automobile. Un champ vide reprend la valeur de company.ts.
  logoUrl               String @default("")
  docAccent             String @default("") // vide = reprend `accent`
  docTheme              String @default("classic")
  emitterName           String @default("")
  emitterAddress        String @default("")
  emitterRepresentative String @default("")
  emitterEmail          String @default("")
  emitterPhone          String @default("")
  emitterSiret          String @default("")
  emitterTva            String @default("")
  emitterIban           String @default("")
  emitterBic            String @default("")
  emitterBank           String @default("")
  legalFootnote         String @default("")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Diffusion multi-portails (module de démonstration : la publication est
// simulée ; le flux d'export XML, lui, est réel — voir /api/admin/diffusion/flux).
model Listing {
  id          String    @id @default(cuid())
  vehicleId   String
  portal      String                        // lacentrale | leboncoin | autoscout24 | facebook
  status      String    @default("non_diffuse") // publie | non_diffuse
  publishedAt DateTime?

  // Empreinte du contenu au moment de la mise en ligne (prix, kilométrage,
  // nombre de photos, description, équipements). Elle sert à dire « la fiche a
  // bougé depuis » sans se fier à la date de dernière écriture, qui bougeait
  // aussi pour un simple changement de statut.
  publishedDigest String @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([vehicleId, portal])
  @@index([vehicleId])
}

// Planning atelier : RDV clients, interventions véhicules, indisponibilités équipe.
model Appointment {
  id         String   @id @default(cuid())
  date       String                        // jour YYYY-MM-DD (saisi tel quel)
  startMin   Int                           // début en minutes depuis minuit
  durationMin Int     @default(60)
  type       String   @default("essai")    // essai | livraison | preparation | ct | mecanique | indispo | autre
  title      String   @default("")
  person     String   @default("")         // qui est concerné (obligatoire pour indispo)
  author     String   @default("")         // qui a créé l'événement (nom d'Atelier, rempli à la création)
  clientId   String?                        // client CRM (optionnel)
  vehicleId  String?                        // véhicule du stock (optionnel)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String   @default("note") // note | appel | email | rdv | etape | creation
  content   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// Réunions : le journal de bord de l'agence. Une réunion est le conteneur daté ;
// ses décisions et ses actions sont des lignes de première classe, requêtables en
// travers de l'année (registre des décisions, liste des actions ouvertes).
// Les chiffres de la situation du jour sont FIGÉS par copie à la création, comme
// les données véhicule d'un dossier Registration : relire une réunion de mars doit
// montrer le stock de mars, pas celui d'aujourd'hui.
model Meeting {
  id          String   @id @default(cuid())
  date        String                        // jour YYYY-MM-DD (saisi tel quel)
  title       String   @default("")
  kind        String   @default("interne")  // interne | banque | partenaire | fournisseur | client | autre
  attendees   String   @default("[]")       // JSON string[] : participants
  location    String   @default("")         // "Agence", "Visio", "BNP Paris 17e"
  summary     String   @default("")         // relevé de discussion, texte libre
  snapshot    String   @default("{}")       // JSON figé à la création (voir MeetingSnapshot)
  attachments String   @default("[]")       // JSON [{ label, url }] — Vercel Blob
  author      String   @default("")         // signature du créateur, posée côté serveur
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MeetingItem[]

  @@index([date])
}

// Décision prise ou action à mener pendant une réunion. La cascade suit le
// précédent LeadEvent → Lead : une ligne meurt avec la réunion qui la porte.
model MeetingItem {
  id        String   @id @default(cuid())
  meetingId String
  type      String   @default("decision") // decision | action
  content   String   @default("")
  owner     String   @default("")         // responsable (actions)
  dueDate   String   @default("")         // échéance YYYY-MM-DD (actions, optionnelle)
  status    String   @default("a_faire")  // a_faire | fait — ignoré pour les décisions
  doneAt    String   @default("")         // YYYY-MM-DD du passage à fait
  position  Int      @default(0)          // ordre d'affichage dans la fiche
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([status])
}

// Comptes entre associés (César / Fab) : dépenses communes, avances, règlements.
model LedgerEntry {
  id          String   @id @default(cuid())
  date        String                       // jour comptable YYYY-MM-DD (saisi tel quel)
  label       String   @default("")
  category    String   @default("autre")
  amountCents Int                          // montant en centimes (> 0)
  paidBy      String                       // qui a déboursé : "César" | "Fab"
  scope       String   @default("commun")  // bénéficiaire : "commun" | "César" | "Fab"
  share       Int      @default(50)        // part (%) supportée par le payeur quand scope = commun
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Dossiers d'immatriculation (habilitation SIV) : import UE principalement,
// changement de titulaire et duplicata à la marge.
// Les données véhicule sont recopiées plutôt que référencées : le Vehicle
// continue de vivre (vendu, modifié, supprimé) alors que le dossier doit rester
// figé pendant les 5 ans de conservation réglementaire.
model Registration {
  id            String   @id @default(cuid())
  reference     String   @unique                 // référence interne lisible, ex "IMM-2026-014"
  type          String   @default("import_ue")   // import_ue | titulaire | duplicata
  status        String   @default("brouillon")   // brouillon | pieces | quitus | pret | transmis | immatricule | archive

  // Rattachements (optionnels : un dossier peut précéder la fiche véhicule)
  vehicleId     String?
  clientId      String?

  // Identité du véhicule, figée au dossier
  vehicleLabel  String   @default("")            // ex "BMW Série 3 320d"
  vin           String   @default("")
  plateForeign  String   @default("")            // immatriculation d'origine
  plateFinal    String   @default("")            // immatriculation française obtenue
  countryOrigin String   @default("Allemagne")
  firstRegDate  String   @default("")            // 1re mise en circulation YYYY-MM-DD
  mileageKm     Int      @default(0)             // kilométrage à l'acquisition

  // Titulaire, figé au dossier
  holderName    String   @default("")
  holderAddress String   @default("")

  // Dates clés
  acquiredOn    String   @default("")            // acquisition YYYY-MM-DD (départ du délai de 30 j)
  deliveredOn   String   @default("")            // livraison YYYY-MM-DD (départ du délai de quitus)
  registeredOn  String   @default("")            // immatriculation obtenue YYYY-MM-DD

  // Fiscal
  vatRegime     String   @default("occasion")    // neuf | occasion (calculé, ajustable à la main)
  purchaseCents Int      @default(0)             // prix d'achat en centimes (base du calcul de TVA)
  quitusRef     String   @default("")
  quitusDate    String   @default("")            // YYYY-MM-DD

  // Télétransmission SIV
  sivRef        String   @default("")            // numéro de dossier SIV

  // Coffre-fort numérique : notre stockage prépare, le coffre-fort certifié
  // conserve et fait foi. On garde ici la référence de versement.
  archiveRef    String   @default("")
  archivedAt    String   @default("")            // YYYY-MM-DD

  documents     String   @default("[]")          // JSON [{ key, label, url, uploadedAt }]
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@index([clientId])
}

// Reprises : estimation d'un véhicule que le client veut céder.
//
// Les données véhicule sont recopiées plutôt que référencées, comme pour les
// dossiers d'immatriculation : la fiche client et la fiche de stock continuent
// de vivre alors que l'estimation doit rester le reflet fidèle de ce qui a été
// constaté le jour de l'évaluation.
//
// clientId / leadId / vehicleId sont des colonnes NUES, volontairement privées
// de relation Prisma. Elles servent de trace d'origine, et la lecture vérifie
// l'existence avant d'afficher un lien. Conséquence voulue : l'effacement RGPD,
// qui supprime les pistes commerciales en cascade, laisse l'opération d'achat
// en place, anonymisée.
//
// Tous les montants sont en centimes, comme VehicleCost.amountCents et
// Registration.purchaseCents. Toutes les dates métier sont des chaînes
// YYYY-MM-DD, jamais des DateTime.
model Reprise {
  id        String @id @default(cuid())
  reference String @unique                  // « REP-2026-014 », remise à 1 chaque année
  status    String @default("brouillon")    // brouillon | proposee | acceptee | refusee | au_stock

  // Rattachements
  clientId  String?
  leadId    String?                          // affaire commerciale ouverte à la création
  vehicleId String?                          // fiche de stock créée au passage au stock

  // Vendeur, figé à l'estimation
  ownerName    String @default("")
  ownerCompany String @default("")
  ownerEmail   String @default("")
  ownerPhone   String @default("")

  // Identité du véhicule évalué
  make         String @default("")
  model        String @default("")
  version      String @default("")           // finition, motorisation
  year         Int    @default(0)
  mileageKm    Int    @default(0)
  fuel         String @default("Essence")
  transmission String @default("Manuelle")
  color        String @default("")
  plate        String @default("")           // immatriculation, en majuscules
  vin          String @default("")           // numéro de série, en majuscules
  firstRegDate String @default("")           // 1re mise en circulation YYYY-MM-DD

  // Points de contrôle relevés à l'évaluation. Les deux booléens sont ceux qui
  // bloquent une revente : un crédit en cours se solde avant la cession, et une
  // carte grise au nom d'un tiers demande la signature du titulaire.
  ctDate        String  @default("")         // dernier contrôle technique YYYY-MM-DD
  ctStatus      String  @default("")         // favorable | contre_visite | absent
  owners        Int     @default(0)          // nombre de propriétaires
  serviceBook   String  @default("")         // complet | partiel | absent
  keys          Int     @default(0)          // nombre de clés remises
  creditPending Boolean @default(false)
  creditCents   Int     @default(0)          // solde restant dû au prêteur
  titleInName   Boolean @default(true)
  condition     String  @default("")         // état constaté, texte libre

  // Chiffrage, en centimes. Exploité à partir du lot 3.
  resaleCents      Int @default(0)           // revente visée, TTC
  reconditionCents Int @default(0)           // remise en état estimée
  offerCents       Int @default(0)           // offre de reprise faite au vendeur

  // Validité de l'offre. Une cote d'occasion bouge : une offre a une fin.
  offerDate    String @default("")           // jour de l'offre YYYY-MM-DD
  validityDays Int    @default(15)

  // Prochaine action, sur le modèle de Lead.nextActionAt. Colonnes posées dès
  // la première migration : Prisma sélectionne toutes les colonnes du modèle au
  // retour d'un create, donc une colonne déclarée et absente de la base fait
  // échouer la première écriture, sans que la compilation dise quoi que ce soit.
  nextActionAt    String @default("")        // jour YYYY-MM-DD, vide = rien de prévu
  nextActionLabel String @default("")        // « Relancer le vendeur »

  // Issue
  decidedOn     String @default("")          // jour d'acceptation ou de refus YYYY-MM-DD
  refusalReason String @default("")          // offre_basse | vendu_particulier | repris_ailleurs | garde_vehicule | etat | autre
  stockedOn     String @default("")          // jour du passage au stock YYYY-MM-DD

  photos    String   @default("[]")          // JSON [ "url", … ]
  notes     String   @default("")
  author    String   @default("")            // signature du créateur, posée côté serveur
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RepriseEvent[]

  @@index([status])
  @@index([clientId])
  @@index([offerDate])
  @@index([vehicleId])
  @@index([nextActionAt])
}

// Journal d'une estimation : révisions de prix, changements de statut, notes.
// Une offre qui passe de 15 490 € à 14 800 € laisse une trace datée et signée,
// seul moyen de répondre six mois plus tard à « quel prix lui a-t-on annoncé ».
model RepriseEvent {
  id        String   @id @default(cuid())
  repriseId String
  type      String   @default("note")        // creation | revision | statut | note
  content   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())

  reprise Reprise @relation(fields: [repriseId], references: [id], onDelete: Cascade)

  @@index([repriseId])
}

// Visites du site public : une ligne par page affichée.
//
// Aucune relation vers Client ni Lead : le carnet clients et l'audience restent
// étanches, et un effacement RGPD d'un côté laisse l'autre intact.
//
// Le visiteur porte un identifiant tiré au sort, posé en cookie technique et
// périmé au bout de treize mois. L'adresse IP reste à l'écart de la table : le
// pays vient d'un en-tête de l'hébergeur, lu puis oublié.
//
// `day` porte le jour de Paris, recopié à l'écriture : les compteurs se lisent
// alors par journée sans refaire un calcul de fuseau à chaque requête, comme
// les dates métier de Reprise. Aucune colonne `updatedAt` : une visite est un
// fait daté, jamais retouché.
//
// L'origine (src, referrer, channel) est celle de la PREMIÈRE page de la visite,
// recopiée sur chacune des suivantes via les cookies de visite. Un clic venu de
// Leboncoin reste donc attribué sur la fiche ouverte trois pages plus loin.
model PageView {
  id String @id @default(cuid())

  day  String // jour de Paris YYYY-MM-DD, recopié à l'écriture
  path String // chemin sans paramètres ni ancre, ex "/vehicules/abc123"

  // D'où : le marqueur ?src= des liens que l'on sème (annonces portails, carte
  // de visite, signature email), et le site qui a renvoyé, à défaut.
  src      String @default("") // valeur de ?src=, en minuscules, ex "leboncoin"
  referrer String @default("") // domaine d'origine sans www, ex "google.fr"
  channel  String @default("direct") // lien | recherche | portail | social | site | direct

  // Qui, sans savoir qui
  visitorId String  @default("") // identifiant tiré au sort, cookie de treize mois
  sessionId String  @default("") // identifiant de la visite, cookie qui meurt avec l'onglet
  device    String  @default("ordinateur") // mobile | tablette | ordinateur
  country   String  @default("") // code pays à deux lettres fourni par l'hébergeur
  isEntry   Boolean @default(false) // première page de la visite : une visite se compte ici
  isNew     Boolean @default(false) // première venue de cet identifiant

  createdAt DateTime @default(now())

  // Deux index seulement : la table s'écrit bien plus souvent qu'elle ne se lit,
  // et chaque index supplémentaire est un coût à chaque page vue. `day, isEntry`
  // sert tous les comptages de l'écran, `createdAt` sert le journal.
  @@index([day, isEntry])
  @@index([createdAt])
}
