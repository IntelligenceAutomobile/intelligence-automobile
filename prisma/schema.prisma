generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String
  model        String
  year         Int
  mileage      Int
  price        Int
  color        String
  transmission String   @default("Automatique")
  fuel         String   @default("Diesel")
  power        Int?
  origin       String   @default("Allemagne")
  description   String   @default("")
  descriptionEn String   @default("")
  features      String   @default("[]")
  featuresEn    String   @default("[]")
  images       String   @default("[]")
  conditionFacts        String   @default("[]")
  maintenanceHistory    String   @default("[]")
  maintenanceHighlights String   @default("[]")
  documents             String   @default("[]")
  status       String   @default("disponible")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model CollabNote {
  id        String          @id @default(cuid())
  content   String
  status    String          @default("todo")
  tag       String          @default("général")
  urgency   String          @default("normale")
  author    String
  category  String          @default("général")
  imageUrl  String?
  images    String          @default("[]")
  attachments String        @default("[]")
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  CollabComment[]
}

model CollabComment {
  id        String          @id @default(cuid())
  noteId    String
  parentId  String?
  content   String
  attachments String        @default("[]")
  author    String
  createdAt DateTime        @default(now())
  note      CollabNote      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parent    CollabComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CollabComment[] @relation("CommentReplies")
}

model Quote {
  id     String @id @default(cuid())
  number String @unique

  kind   String @default("vehicule")  // vehicule | prestation
  status String @default("brouillon") // brouillon | envoye | accepte | refuse

  // Type de document et facturation
  docType       String  @default("devis")    // devis | facture
  factureKind   String  @default("complete") // complete | acompte | solde (si docType = facture)
  paymentStatus String  @default("impayee")  // impayee | payee (si docType = facture)
  paidDate      String  @default("")         // YYYY-MM-DD de paiement
  sourceQuoteId String?                        // devis d'origine (conversion)

  // Relances (suivi commercial / paiement)
  relanceCount       Int    @default(0)
  lastRelanceDate    String @default("")      // YYYY-MM-DD de la dernière relance
  relanceSnoozeUntil String @default("")      // YYYY-MM-DD : masqué du centre de relances jusqu'à

  // Client (destinataire)
  clientName    String @default("")
  clientCompany String @default("")
  clientAddress String @default("")
  clientEmail   String @default("")
  clientPhone   String @default("")

  // Dates (chaînes calendaires YYYY-MM-DD, éditées telles quelles)
  issueDate    String
  validityDays Int    @default(30)

  // Lignes : JSON [{ designation, detail, qty, unitPrice, vehicleId? }]
  // unitPrice = HT en mode "tva20", TTC en modes "marge"/"exonere"
  items String @default("[]")

  // Fiscalité
  tvaMode String @default("marge") // marge | tva20 | exonere
  tvaRate Int    @default(20)

  // Acompte
  depositMode  String @default("percent") // percent | amount | none
  depositValue Float  @default(30)

  // Texte libre
  paymentTerms String @default("")
  notes        String @default("")

  // Personnalisation émetteur + logo (JSON) : { emitterName, emitterAddress, …, logoAlign, logoSize, logoVisible }
  branding String @default("{}")

  // Lien véhicule principal (optionnel)
  vehicleId String?

  // Lien client CRM (optionnel)
  clientId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── CRM : clients et opportunités de vente ──

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Lead {
  id        String      @id @default(cuid())
  clientId  String
  stage     String      @default("nouveau") // nouveau | contacte | rdv | devis_envoye | gagne | perdu
  source    String      @default("manuel")  // site-contact | recherche-perso | aide-vente | manuel | telephone | autre
  title     String      @default("")        // objet (ex: "Recherche SUV hybride")
  vehicleId String?                          // véhicule du stock concerné (optionnel)
  budget    Int?                             // budget indicatif en euros
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events    LeadEvent[]

  @@index([clientId])
  @@index([stage])
}

// Suivi par véhicule : frais engagés (pour la marge) et journal d'enquête
// (problèmes constatés, solutions, administratif). Pas de suivi de réparation.
model VehicleCost {
  id          String   @id @default(cuid())
  vehicleId   String
  category    String   @default("autre") // achat | transport | preparation | controle | carrosserie | administratif | autre
  label       String   @default("")
  amountCents Int
  date        String                       // jour YYYY-MM-DD (saisi tel quel)
  createdAt   DateTime @default(now())

  @@index([vehicleId])
}

model VehicleNote {
  id        String   @id @default(cuid())
  vehicleId String
  type      String   @default("info") // probleme | solution | info | admin
  content   String
  resolved  Boolean  @default(false)   // pour les problèmes : réglé ou non
  author    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
}

// Marque blanche : thème visuel de l'instance (une seule ligne, id "default").
model BrandTheme {
  id        String   @id @default("default")
  name      String   @default("Intelligence Automobile")
  tagline   String   @default("Back-office")
  accent    String   @default("#6B9FEE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Diffusion multi-portails (module de démonstration : la publication est
// simulée ; le flux d'export XML, lui, est réel — voir /api/admin/diffusion/flux).
model Listing {
  id          String    @id @default(cuid())
  vehicleId   String
  portal      String                        // lacentrale | leboncoin | autoscout24 | facebook
  status      String    @default("non_diffuse") // publie | non_diffuse
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([vehicleId, portal])
  @@index([vehicleId])
}

// Planning atelier : RDV clients, interventions véhicules, indisponibilités équipe.
model Appointment {
  id         String   @id @default(cuid())
  date       String                        // jour YYYY-MM-DD (saisi tel quel)
  startMin   Int                           // début en minutes depuis minuit
  durationMin Int     @default(60)
  type       String   @default("essai")    // essai | livraison | preparation | ct | mecanique | indispo | autre
  title      String   @default("")
  person     String   @default("")         // qui est concerné (obligatoire pour indispo)
  clientId   String?                        // client CRM (optionnel)
  vehicleId  String?                        // véhicule du stock (optionnel)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String   @default("note") // note | appel | email | rdv | etape | creation
  content   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// Comptes entre associés (César / Fab) : dépenses communes, avances, règlements.
model LedgerEntry {
  id          String   @id @default(cuid())
  date        String                       // jour comptable YYYY-MM-DD (saisi tel quel)
  label       String   @default("")
  category    String   @default("autre")
  amountCents Int                          // montant en centimes (> 0)
  paidBy      String                       // qui a déboursé : "César" | "Fab"
  scope       String   @default("commun")  // bénéficiaire : "commun" | "César" | "Fab"
  share       Int      @default(50)        // part (%) supportée par le payeur quand scope = commun
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
