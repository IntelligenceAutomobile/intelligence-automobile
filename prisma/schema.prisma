generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String
  model        String
  year         Int
  mileage      Int
  price        Int
  color        String
  transmission String   @default("Automatique")
  fuel         String   @default("Diesel")
  power        Int?
  origin       String   @default("Allemagne")
  description  String   @default("")
  features     String   @default("[]")
  images       String   @default("[]")
  status       String   @default("disponible")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model CollabNote {
  id        String   @id @default(cuid())
  content   String
  status    String   @default("todo")
  tag       String   @default("général")
  author    String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
